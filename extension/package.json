{
  "name": "@studylens/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:edge": "wxt -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:edge": "wxt build -b edge",
    "build:e2e": "wxt build -b edge --mode e2e",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:edge": "wxt zip -b edge",
    "check:builds": "node scripts/check-builds.mjs",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "npm run build:e2e && node scripts/screenshots.mjs",
    "test:e2e": "npm run build:e2e && playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@studylens/shared": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "wxt": "^0.21.5"
  }
}
