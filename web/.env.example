# Copy to web/.env.local for local development (.env.local is gitignored; never commit real values).
# On Vercel, set these in Project -> Settings -> Environment Variables instead.

# Turso database URL, e.g. libsql://studylens-<your-name>.turso.io
# For local development you can use a file on M: instead (relative to web/):
#   TURSO_DATABASE_URL=file:.data/dev.db
# Leave empty to use the in-memory stub (data is lost on restart).
TURSO_DATABASE_URL=

# Turso auth token (not needed for a local file: URL).
TURSO_AUTH_TOKEN=

# Random secret that protects GET /api/cleanup (Vercel Cron sends it automatically).
CRON_SECRET=
